#!/bin/sh

# Check if dependencies changed
if git diff HEAD@{1}..HEAD --name-only | grep -q "package.json"; then
  echo "📦 package.json changed. Consider running: npm ci"
fi

# Check if database migrations changed
if git diff HEAD@{1}..HEAD --name-only | grep -q "supabase/migrations/"; then
  echo "🗄️  Database migrations changed. Run: npm run db:migrate"
fi
